# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# This repository stores no credentials. Every value below is supplied by the
# developer or the deployment environment, and nothing in src/ writes a secret
# to disk or logs one (see src/journaling/database.py::redact_url).

# --- local Postgres (docker compose) ----------------------------------------
POSTGRES_USER=trading
POSTGRES_PASSWORD=
POSTGRES_DB=trading

# --- application ------------------------------------------------------------
# SQLAlchemy URL. No default exists in code: a missing value raises rather than
# quietly connecting somewhere unintended.
TRADING_DATABASE_URL=postgresql+psycopg://trading:@localhost:5432/trading
TRADING_ECHO_SQL=false

# --- Robinhood MCP ----------------------------------------------------------
# Intentionally absent. The MCP session is supplied by the host process, already
# authenticated. No brokerage credential is ever read by this codebase.
