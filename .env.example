# Copy to .env for local development ONLY. Never commit .env.
# In production, inject these from a secrets manager (e.g. Azure Key Vault)
# at process start.

# --- Coinbase Advanced Trade (CDP API key) ---
# Create at https://portal.cdp.coinbase.com/ with only "view" + "trade"
# permissions; download the JSON key once and store the PEM here with
# newlines escaped as \n.
COINBASE_API_KEY_NAME=organizations/{org_id}/apiKeys/{key_id}
COINBASE_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n

# --- Binance.US ---
# Create under API Management; restrict to your egress IPs and enable only
# "Enable Reading" + "Enable Spot Trading" (never withdrawals).
BINANCEUS_API_KEY=
BINANCEUS_API_SECRET=

# --- Robinhood (unofficial API via robin_stocks) ---
# TOTP seed comes from enabling an authenticator app on the account.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_TOTP_SECRET=
